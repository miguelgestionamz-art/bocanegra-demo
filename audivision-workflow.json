            "email": "={{ $json.email }}",
            "servicio": "={{ $json.servicio }}",
            "fecha_inicio": "={{ $json.fecha_inicio }}",
            "fecha_fin": "={{ $json.fecha_fin }}",
            "estado": "={{ $json.estado }}",
