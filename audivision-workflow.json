    {
      "id": "cd-004",
      "name": "Formatear Mensaje Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 1200],
      "parameters": {
        "jsCode": "const error = $input.first().json;\n\nconst workflowName = error.workflow?.name || 'Audivisión';\nconst nodeName = error.node?.name || 'Nodo desconocido';\nconst errorMsg = error.error?.message || error.message || 'Sin mensaje de error';\nconst errorStack = (error.error?.stack || '').substring(0, 500);\nconst execId = error.execution?.id || 'N/A';\n\nconst timestamp = new Date().toLocaleString('es-ES', {\n  timeZone: 'Europe/Madrid',\n  day: '2-digit', month: '2-digit', year: 'numeric',\n  hour: '2-digit', minute: '2-digit', second: '2-digit'\n});\n\nconst mensajeTelegram = [\n  '⚠️ <b>Error en Audivisión</b>',\n  '',\n  `📌 <b>Workflow:</b> ${workflowName}`,\n  `🔴 <b>Nodo:</b> ${nodeName}`,\n  `❌ <b>Error:</b> ${errorMsg}`,\n  `🕐 <b>Hora:</b> ${timestamp}`,\n  `🆔 <b>Ejecución:</b> ${execId}`\n].join('\\n');\n\nreturn [{\n  json: {\n    workflow_name: workflowName,\n    nodo_nombre: nodeName,\n    mensaje_error: errorMsg,\n    stack_trace: errorStack,\n    timestamp,\n    mensaje_telegram: mensajeTelegram\n  }\n}];"
      }
    },
