    {
      "id": "wh-001",
      "name": "Webhook Cal.com",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [160, 120],
      "webhookId": "audivision-calcom-booking",
      "parameters": {
        "httpMethod": "POST",
        "path": "audivision-calcom",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      }
    },
    {
      "id": "cd-001",
      "name": "Extraer Datos Cal.com",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 120],
      "parameters": {
        "jsCode": "// Normaliza el payload de Cal.com BOOKING_CREATED\nconst body = $input.first().json;\nconst payload = body.payload || body;\n\n// Attendees: el cliente es el que NO es el organizador\nconst attendees = payload.attendees || [];\nconst organizer = payload.organizer || {};\nconst cliente = attendees.find(a => a.email !== organizer.email) || attendees[0] || {};\n\n// Extraer campos\nconst booking_id = String(payload.uid || payload.bookingUid || payload.id || Date.now());\nconst cliente_nombre = (cliente.name || payload.responses?.name?.value || '').trim();\nconst email = (cliente.email || payload.responses?.email?.value || '').toLowerCase().trim();\n\n// Normalizar teléfono (quitar espacios, 00 → +)\nconst telefonoRaw = (\n  payload.responses?.phone?.value ||\n  payload.responses?.phone_number?.value ||\n  payload.metadata?.phone ||\n  ''\n);\nconst telefono = telefonoRaw.replace(/\\s+/g, '').replace(/^00/, '+');\n\nconst servicio = (payload.eventTitle || payload.title || payload.type || 'Consulta Audivisión').trim();\nconst fecha_inicio = payload.startTime || '';\nconst fecha_fin = payload.endTime || '';\n\nreturn [{\n  json: {\n    booking_id,\n    cliente_nombre,\n    telefono,\n    email,\n    servicio,\n    fecha_inicio,\n    fecha_fin,\n    estado: 'CONFIRMADA',\n    sms_enviado: 'FALSE',\n    resena_enviada: 'FALSE'\n  }\n}];"
      }
    },
    {
