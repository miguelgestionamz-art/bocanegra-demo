    {
      "id": "cd-003",
      "name": "Filtrar Solicitud Resena",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 600],
      "parameters": {
        "jsCode": "// Selecciona filas donde la cita pasó hace 23-25h y resena_enviada=FALSE\n// La verificación en Sheets ya garantiza que no se envía duplicado\nconst ahora = new Date();\nconst resultados = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n\n  // Anti-duplicado: saltar si la reseña ya fue solicitada\n  if (['true', 'TRUE', '1', true, 'Verdadero', 'verdadero'].includes(row.resena_enviada)) continue;\n\n  // Saltar filas sin teléfono o booking_id\n  if (!row.telefono || !row.booking_id) continue;\n\n  // Calcular horas desde/hasta la cita (negativo = ya pasó)\n  const fechaCita = new Date(row.fecha_inicio);\n  if (isNaN(fechaCita.getTime())) continue;\n\n  const diffHoras = (fechaCita - ahora) / (1000 * 60 * 60);\n\n  // Ventana: entre -25h y -23h (cita ocurrió hace 23-25 horas)\n  if (diffHoras >= -25 && diffHoras <= -23) {\n    resultados.push({ json: { ...row } });\n  }\n}\n\nreturn resultados; // Array vacío = nodos siguientes no se ejecutan"
      }
    },
