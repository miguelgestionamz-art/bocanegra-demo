    {
      "id": "cd-002",
      "name": "Filtrar Recordatorio SMS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1260, 80],
      "parameters": {
        "jsCode": "// Selecciona citas dentro de la ventana 23-25h con sms_enviado=FALSE\n// Si retorna vacío los nodos siguientes no se ejecutan (anti-duplicado nativo)\nconst ahora = new Date();\nconst resultados = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n\n  // Anti-duplicado: saltar si el flag ya está marcado\n  if (['true','TRUE','1',true,'Verdadero'].includes(row.sms_enviado)) continue;\n\n  if (!row.telefono || !row.booking_id) continue;\n\n  const fechaCita = new Date(row.fecha_inicio);\n  if (isNaN(fechaCita.getTime())) continue;\n\n  const diffHoras = (fechaCita - ahora) / (1000 * 60 * 60);\n\n  // Ventana: 23h a 25h ANTES de la cita\n  if (diffHoras >= 23 && diffHoras <= 25) {\n    resultados.push({ json: { ...row } });\n  }\n}\n\nreturn resultados;"
      }
    },
    {
      "id": "hr-001",
      "name": "Brevo SMS Recordatorio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 80],
      "parameters": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/transactionalSMS/sms",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "api-key", "value": "={{ $env.BREVO_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({\n  type: 'transactional',\n  unicodeEnabled: false,\n  sender: 'Audivision',\n  recipient: $json.telefono,\n  content: 'Hola ' + $json.cliente_nombre + ', te recordamos tu cita en Audivisión mañana. Servicio: ' + $json.servicio + '. Cancelaciones: ' + $env.CALCOM_BOOKING_LINK + ' ¡Te esperamos!'\n}) }}",
        "options": {}
      }
    },
