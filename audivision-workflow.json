    {
      "id": "cd-002",
      "name": "Filtrar Recordatorio SMS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 360],
      "parameters": {
        "jsCode": "// Selecciona filas con cita en ventana 23-25h y sms_enviado=FALSE\n// La verificación en Sheets ya garantiza que no se envía duplicado\nconst ahora = new Date();\nconst resultados = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n\n  // Anti-duplicado: saltar si el SMS ya fue enviado\n  if (['true', 'TRUE', '1', true, 'Verdadero', 'verdadero'].includes(row.sms_enviado)) continue;\n\n  // Saltar filas sin teléfono o booking_id\n  if (!row.telefono || !row.booking_id) continue;\n\n  // Calcular horas hasta la cita\n  const fechaCita = new Date(row.fecha_inicio);\n  if (isNaN(fechaCita.getTime())) continue;\n\n  const diffHoras = (fechaCita - ahora) / (1000 * 60 * 60);\n\n  // Ventana: entre 23h y 25h antes de la cita\n  if (diffHoras >= 23 && diffHoras <= 25) {\n    resultados.push({ json: { ...row } });\n  }\n}\n\nreturn resultados; // Array vacío = nodos siguientes no se ejecutan"
      }
    },
