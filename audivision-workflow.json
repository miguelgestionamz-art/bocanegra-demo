    {
      "id": "cd-003",
      "name": "Filtrar Solicitud Resena",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1260, 320],
      "parameters": {
        "jsCode": "// Selecciona citas que pasaron hace 23-25h con resena_enviada=FALSE\n// Si retorna vacío los nodos siguientes no se ejecutan (anti-duplicado nativo)\nconst ahora = new Date();\nconst resultados = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n\n  // Anti-duplicado: saltar si el flag ya está marcado\n  if (['true','TRUE','1',true,'Verdadero'].includes(row.resena_enviada)) continue;\n\n  if (!row.telefono || !row.booking_id) continue;\n\n  const fechaCita = new Date(row.fecha_inicio);\n  if (isNaN(fechaCita.getTime())) continue;\n\n  const diffHoras = (fechaCita - ahora) / (1000 * 60 * 60); // negativo si ya pasó\n\n  // Ventana: entre -25h y -23h (cita hace 23-25 horas)\n  if (diffHoras >= -25 && diffHoras <= -23) {\n    resultados.push({ json: { ...row } });\n  }\n}\n\nreturn resultados;"
      }
    },
